{
  "name": "composepress/core",
  "type": "library",
  "description": "A small WordPress plugin runtime boundary",
  "license": "LGPL-3.0-or-later",
  "config": {
    "platform": {
      "php": "8.2.0"
    }
  },
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.2",
    "php-stubs/wordpress-stubs": "^6.4",
    "squizlabs/php_codesniffer": "^3.13",
    "yoast/phpunit-polyfills": "^4.0",
    "humbug/php-scoper": "^0.18"
  },
  "autoload": {
    "psr-4": {
      "ComposePress\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ComposePress\\Core\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-text",
    "test:integration": "phpunit -c phpunit.integration.xml.dist",
    "analyse": "phpstan analyse",
    "style": "phpcs --standard=.phpcs.xml.dist src tests",
    "scope": "php vendor/bin/php-scoper add-prefix --config=scoper.inc.php --prefix=ComposePressScoped --output-dir=build --force",
    "scope:check": "php tools/verify-scoped-build.php"
  }
}
